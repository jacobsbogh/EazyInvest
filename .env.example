# Leave all Firebase values empty for the local demo. Never put private API keys in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
# Use /REPOSITORY-NAME/ when eventually building for project GitHub Pages.
VITE_BASE_PATH=/
